{
  "tasks": {
    "dev": "deno serve --watch --env-file=.env main.ts",
    "db:up": "docker compose up -d",
    "db:generate:migration": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "imports": {
    "@better-auth/cli": "npm:@better-auth/cli@^1.4.1",
    "@prisma/client": "npm:@prisma/client@5.22.0",
    "@prisma/engines": "npm:@prisma/engines@5.22.0",
    "@std/assert": "jsr:@std/assert@1",
    "hono": "npm:hono@4.10.6",
    "drizzle-orm": "npm:drizzle-orm@^0.44.7",
    "pg": "npm:pg@^8.16.3",
    "drizzle-kit": "npm:drizzle-kit@^0.31.7",
    "drizzle-seed": "npm:drizzle-seed@0.3.1",
    "better-auth": "npm:better-auth@^1.4.1",
    "prisma": "npm:prisma@5.22.0",
    "zod": "npm:zod@4.1.12",
    "postgres": "https://deno.land/x/postgresjs/mod.js"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "types": ["node"],
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "nodeModulesDir": "auto"
}
